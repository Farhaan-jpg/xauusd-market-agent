# ==============================================================================
# XAUUSD AI MARKET INTELLIGENCE & LIQUIDITY AGENT - CONFIGURATION
# ==============================================================================

# --- AI PROVIDERS (OPTIONAL - Automatic Deterministic Fallback if omitted) ---
# Primary AI Provider: Google Gemini API (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Secondary AI Provider: OpenRouter API (Get from: https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:free,google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct:free

# AI Provider Priority: 'gemini_first', 'openrouter_first', or 'deterministic_only'
AI_PRIORITY=gemini_first

# --- TELEGRAM BOT (OPTIONAL - Alerts logged locally if omitted) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID (User or Group/Channel ID) from @userinfobot
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true

# --- DATA PROVIDERS & FEEDS ---
# Yahoo Finance Gold & Macro Symbols
SYMBOL_GOLD=GC=F
SYMBOL_XAUUSD_SPOT=XAUUSD=X
SYMBOL_DXY=DX-Y.NYB
SYMBOL_US10Y=^TNX
SYMBOL_US2Y=^IRX
SYMBOL_TIPS=TIP

# Optional Free API Keys for supplemental data
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- RUNTIME & SCHEDULER ---
TIMEZONE=Asia/Kolkata
ANALYSIS_INTERVAL_SECONDS=180
MARKET_DATA_INTERVAL_SECONDS=60
NEWS_FETCH_INTERVAL_SECONDS=180
ECONOMIC_FETCH_INTERVAL_SECONDS=300
PORT=8000
HOST=0.0.0.0

# --- THRESHOLDS & ENGINE SETTINGS ---
LIQUIDITY_TOLERANCE_PIPS=1.5
EVIDENCE_CONFLICT_PENALTY=20
DIRECTION_CHANGE_THRESHOLD_SCORE=15
ALERT_COOLDOWN_MINUTES=30

# --- DATABASE ---
DATABASE_URL=sqlite+aiosqlite:///./data/xauusd_agent.db
